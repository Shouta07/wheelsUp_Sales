# ----------------------------------------------------------------------------
# Wheels Up Sales — env vars
#
# Copy to .env.local for dev (gitignored). For production, set these in your
# host (Vercel project settings) — never commit real values.
#
# If SUPABASE_URL is empty the app runs in mock mode (no DB writes).
# ----------------------------------------------------------------------------

# Supabase REST endpoint. e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Gemini
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ----------------------------------------------------------------------------
# Jina Reader (optional; falls back to plain fetch when absent)
# ----------------------------------------------------------------------------
JINA_API_KEY=

# ----------------------------------------------------------------------------
# Shared API secret. All /api/* endpoints require this.
#
# Preferred: Authorization: Bearer <secret>
# Fallback:  ?secret=...  (only used by legacy callers / Vercel Cron)
#
# Requirements (enforced at runtime — startup of an API route will 500 if
# violated):
#   * MUST NOT be one of: "change-me", "secret", "password", ""
#   * MUST be at least 24 characters
#
# Generate with:    openssl rand -base64 36
# ----------------------------------------------------------------------------
CRON_SECRET=
