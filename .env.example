# ----------------------------------------------------------------------------
# Wheels Up Sales — env vars
#
# Copy to .env.local for dev (gitignored). For production, set these in your
# host (Vercel project settings) — never commit real values.
#
# If SUPABASE_URL is empty the app runs in mock mode (no DB writes, no auth).
# ----------------------------------------------------------------------------

# Server-side (service_role) Supabase REST endpoint.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (anon/publishable) — used by Supabase Auth (magic link login).
# These ARE exposed to the browser. The anon key is safe to expose;
# RLS + ALLOWED_EMAILS still gate access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated list of emails allowed to sign in.
# Anyone else who clicks a magic link is rejected at the callback.
# Required for team auth — without it, no one can sign in.
ALLOWED_EMAILS=alice@example.com,bob@example.com

# ----------------------------------------------------------------------------
# Gemini
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ----------------------------------------------------------------------------
# Jina Reader (optional; falls back to plain fetch when absent)
# ----------------------------------------------------------------------------
JINA_API_KEY=

# ----------------------------------------------------------------------------
# Shared API secret for machine callers (Vercel Cron, curl scripts).
# Browser-driven calls use the user session — no secret needed in the UI.
#
# Preferred: Authorization: Bearer <secret>
# Fallback:  ?secret=...
#
# Requirements (enforced at runtime):
#   * MUST NOT be one of: "change-me", "secret", "password", ""
#   * MUST be at least 24 characters
#
# Generate with:    openssl rand -base64 36
# ----------------------------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------------------------
# Cost guard
# ----------------------------------------------------------------------------
# Emergency killswitch. Set to "true" or "1" to refuse every LLM-calling
# route (crawl/match/discover) with HTTP 503. Use as the 30-second
# response to a key leak or cost-runaway incident.
KILL_LLM=

# Daily cap (UTC) on the number of LLM-calling runs logged to crawl_runs.
# Default: 200. When reached, further calls return HTTP 429 until 00:00
# UTC. This is a circuit breaker, not a fine-grained quota.
LLM_DAILY_RUN_LIMIT=200
