function seedCompaniesBuiltin() {
  var existing = readSheet_(SHEETS.companies);
  var existingNames = {};
  existing.forEach(function (c) { existingNames[c.name] = true; });
  var added = 0;
  for (var i = 0; i < COMPANIES_SEED.length; i++) {
    var s = COMPANIES_SEED[i];
    if (!s.name || existingNames[s.name]) continue;
    var obj = {};
    for (var k in s) { if (s.hasOwnProperty(k)) obj[k] = s[k]; }
    obj.source = obj.source || "seed";
    appendRow_(SHEETS.companies, obj);
    existingNames[s.name] = true;
    added++;
  }
  if (typeof SpreadsheetApp !== "undefined") {
    SpreadsheetApp.getUi().alert(added + " 社を投入しました (既存はスキップ / 内蔵 " + COMPANIES_SEED.length + " 社)");
  }
  return { added: added, total: COMPANIES_SEED.length };
}
